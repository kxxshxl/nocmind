{
 "title": "NOCMind Overview",
 "uid": "nocmind-overview",
 "schemaVersion": 39,
 "version": 2,
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "type": "stat",
   "title": "Active incidents",
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "nocmind_active_incidents",
     "legendFormat": "active",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "type": "stat",
   "title": "Investigations (1h)",
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 6,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(increase(nocmind_investigations_total[1h])) by (outcome, rca_method)",
     "legendFormat": "{{outcome}} / {{rca_method}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "type": "stat",
   "title": "LLM failures (1h)",
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(increase(nocmind_llm_calls_total{status!=\"success\"}[1h]))",
     "legendFormat": "failed/skipped",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "type": "stat",
   "title": "Handled errors (1h)",
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 18,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(increase(nocmind_errors_total[1h]))",
     "legendFormat": "errors",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "API request rate",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(rate(nocmind_requests_total[5m])) by (path)",
     "legendFormat": "{{path}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "API p95 latency",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum(rate(nocmind_request_latency_seconds_bucket[5m])) by (le,path))",
     "legendFormat": "{{path}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Agent node p95 duration",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 13
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum(rate(nocmind_span_duration_seconds_bucket{span=~\"agent.*\"}[5m])) by (le,span))",
     "legendFormat": "{{span}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Tool / RAG / LLM span p95",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 13
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum(rate(nocmind_span_duration_seconds_bucket{span=~\"tool.*|rag.*|llm.*\"}[5m])) by (le,span))",
     "legendFormat": "{{span}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "LLM calls by outcome",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 21
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(rate(nocmind_llm_calls_total[5m])) by (provider, status)",
     "legendFormat": "{{provider}} {{status}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "LLM p95 latency",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 21
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum(rate(nocmind_llm_latency_seconds_bucket[5m])) by (le,provider))",
     "legendFormat": "{{provider}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "LLM tokens / min",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 29
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(rate(nocmind_llm_tokens_total[5m])) by (provider, direction) * 60",
     "legendFormat": "{{provider}} {{direction}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Tool calls by status",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 29
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(rate(nocmind_tool_calls_total[5m])) by (tool, status)",
     "legendFormat": "{{tool}} {{status}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Errors by component",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 37
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(rate(nocmind_errors_total[5m])) by (component, kind)",
     "legendFormat": "{{component}} {{kind}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Remediations",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 37
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(increase(nocmind_remediations_total[1h])) by (action, status)",
     "legendFormat": "{{action}} {{status}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "RAG p95 latency",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 45
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum(rate(nocmind_rag_latency_seconds_bucket[5m])) by (le))",
     "legendFormat": "p95",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  }
 ]
}