# Copy to .env (git-ignored) and adjust. Docker Compose reads this file automatically.

# --- LLM -------------------------------------------------------------------
# Primary provider: ollama (local, default) | openrouter/openai/azure (OpenAI-compatible) | demo (offline, deterministic)
LLM_PROVIDER=demo
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_NUM_CTX=16384
LLM_TIMEOUT_SECONDS=120
# Optional fallback used only when the primary fails (429/5xx/timeout put a provider in cooldown; no retries).
LLM_FALLBACK_PROVIDER=
# OpenAI-compatible endpoint settings (used when LLM_PROVIDER or LLM_FALLBACK_PROVIDER is openrouter/openai/azure)
LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=openrouter/free
# Benchmark judge: ollama (local) | openrouter | none (judge disabled; deterministic metrics only)
EVAL_JUDGE_PROVIDER=ollama

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset/weak, development uses an ephemeral random secret; APP_ENV=production refuses to start.
JWT_SECRET=
APP_ENV=development
DEMO_PASSWORD=nocmind-admin
# Optional role-separated demo accounts (created only when set)
DEMO_OPERATOR_PASSWORD=
DEMO_VIEWER_PASSWORD=
POSTGRES_PASSWORD=nocmind
GRAFANA_ADMIN_PASSWORD=admin

# Local (non-Docker) backend development
DATABASE_URL=sqlite:///./nocmind.db
REDIS_URL=redis://localhost:6379/0
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_BACKEND=sentence_transformer
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
DRY_RUN=true
CORS_ORIGIN=http://localhost:5173
